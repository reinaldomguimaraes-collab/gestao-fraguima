# Postgres — o Coolify gera essa string automaticamente ao criar o banco
DATABASE_URL="postgresql://usuario:senha@host:5432/duo_fraguima?schema=public"

# Gerar com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio"

# URL pública onde o painel vai rodar
NEXTAUTH_URL="https://gestao.fraguima.com.br"

# Credenciais do Google Cloud Console (OAuth) — ver SETUP.md, passo "Login com Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# E-mail transacional (convites) — se deixar em branco, os convites só aparecem no log do servidor
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Duo Fraguima <contato@fraguima.com.br>"
