// Duo Fraguima — Painel de Gestão de Clientes
// Modelo de dados conforme a especificação (Estágio 1), rev. 401.
// Regra de ouro: TODA consulta de dado de cliente é filtrada por empresaId
// vindo da sessão autenticada — nunca por um valor enviado pelo próprio cliente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Equipe interna da Duo Fraguima (não são clientes)
// ---------------------------------------------------------------------------

enum PapelInterno {
  PROPRIETARIO
  COLABORADOR
}

enum StatusConta {
  ATIVO
  PENDENTE
  BLOQUEADO
  REMOVIDO
}

model UsuarioInterno {
  id            String       @id @default(cuid())
  nome          String
  email         String       @unique
  senhaHash     String?
  papel         PapelInterno @default(COLABORADOR)
  status        StatusConta  @default(PENDENTE)
  googleId      String?      @unique
  conviteToken  String?      @unique
  conviteExpira DateTime?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  empresasCriadas Empresa[] @relation("EmpresaCriadaPor")
  impersonacoes   ImpersonacaoLog[]
}

// ---------------------------------------------------------------------------
// Empresa (tenant) — cada cliente da Duo Fraguima
// ---------------------------------------------------------------------------

model Empresa {
  id            String      @id @default(cuid())
  codigo        String      @unique // ex.: CLI-0001, exibido no Administrativo
  nome          String
  cnpj          String?
  responsavel   String
  email         String
  telefone      String?
  status        StatusConta @default(PENDENTE) // ativo | pendente (1º acesso) | bloqueado
  criadoPor     UsuarioInterno? @relation("EmpresaCriadaPor", fields: [criadoPorId], references: [id])
  criadoPorId   String?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt

  usuarios          Usuario[]
  parametros        ParametrosEmpresa?
  funcionarios      Funcionario[]
  veiculos          Veiculo[]
  terceirizados     Terceirizado[]
  custosFixos       CustoFixo[]
  produtosServicos  ProdutoServico[]
  vendas            Venda[]
  metasFrente       MetaFrente[]
  lancamentosCaixa  LancamentoCaixa[]
  planoNegocio      PlanoNegocio?
  aceiteTermos      AceiteTermos?
  impersonacoes     ImpersonacaoLog[]
}

// Papel de um Usuario (login do lado do cliente) dentro da própria empresa.
// DONO é quem assinou/criou a conta (1 por empresa, criado pelo Administrativo);
// MEMBRO é convidado pelo DONO (fase 2 — múltiplos usuários por empresa).
enum PapelUsuario {
  DONO
  MEMBRO
}

// Login de acesso do lado do cliente — múltiplos usuários por empresa (fase 2)
model Usuario {
  id            String       @id @default(cuid())
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  nome          String
  email         String       @unique
  senhaHash     String?
  papel         PapelUsuario @default(DONO)
  googleId      String?      @unique
  conviteToken  String?      @unique
  conviteExpira DateTime?
  // Acesso removido pelo DONO (membro continua existindo, mas não consegue mais logar).
  // Não existe um enum de "status" aqui de propósito: ativo/pendente já é derivável de
  // (senhaHash || googleId) sem precisar de um campo cujo valor inicial, para os
  // Usuarios já existentes antes desta coluna, seria um chute.
  removidoEm    DateTime?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  @@index([empresaId])
}

// Registro do aceite do termo de uso no 1º login do cliente (cobertura jurídica)
model AceiteTermos {
  id        String   @id @default(cuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String   @unique
  nome      String
  ip        String
  aceitoEm  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Parâmetros da empresa (configurado uma vez, usado em Precificação)
// ---------------------------------------------------------------------------

model ParametrosEmpresa {
  id                  String   @id @default(cuid())
  empresa             Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId           String   @unique
  regimeTributario    String   @default("Simples Nacional")
  horasUteisMes       Decimal  @default(220) @db.Decimal(10, 2)
  percImpostos        Decimal  @default(6) @db.Decimal(6, 2)
  percLucroDesejado   Decimal  @default(15) @db.Decimal(6, 2)
  percRisco           Decimal  @default(3) @db.Decimal(6, 2)
  percTaxaCartao      Decimal  @default(3.5) @db.Decimal(6, 2)
  percFatorInstalacao Decimal  @default(0) @db.Decimal(6, 2)
  comissaoGlobal      Decimal  @default(0) @db.Decimal(6, 2)
  comissaoIndicacao   Decimal  @default(1) @db.Decimal(6, 2)
  comissaoMC          Decimal  @default(0) @db.Decimal(6, 2)
  custoComercialMes   Decimal  @default(0) @db.Decimal(12, 2)
  atualizadoEm        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cadastros — Funcionários, Veículos, Terceirizados
// ---------------------------------------------------------------------------

model Funcionario {
  id             String   @id @default(cuid())
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId      String
  nome           String
  funcao         String
  salarioBase    Decimal  @db.Decimal(12, 2)
  percEncargos   Decimal  @default(0) @db.Decimal(6, 2)
  valeAlimentacao Decimal @default(0) @db.Decimal(12, 2)
  valeTransporte Decimal  @default(0) @db.Decimal(12, 2)
  planoSaude     Decimal  @default(0) @db.Decimal(12, 2)
  bonificacao    Decimal  @default(0) @db.Decimal(12, 2)
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())

  maoDeObraServicos ServicoMaoDeObra[]

  @@index([empresaId])
}

model Veiculo {
  id            String   @id @default(cuid())
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  nome          String
  valorVeiculo  Decimal  @default(0) @db.Decimal(12, 2)
  seguroMensal  Decimal  @default(0) @db.Decimal(12, 2)
  ipvaMensal    Decimal  @default(0) @db.Decimal(12, 2)
  manutencao    Decimal  @default(0) @db.Decimal(12, 2)
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())

  maoDeObraServicos ServicoMaoDeObra[]

  @@index([empresaId])
}

enum TipoCobrancaTerceirizado {
  DIARIA
  PLACA
}

model Terceirizado {
  id            String                   @id @default(cuid())
  empresa       Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  nome          String
  tipoCobranca  TipoCobrancaTerceirizado @default(DIARIA)
  valorDiaria   Decimal?                 @db.Decimal(12, 2) // usado quando tipoCobranca = DIARIA
  valorPlaca    Decimal?                 @db.Decimal(12, 2) // usado quando tipoCobranca = PLACA (valor por placa instalada)
  ativo         Boolean                  @default(true)
  criadoEm      DateTime                 @default(now())

  maoDeObraServicos ServicoMaoDeObra[]

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Custos Fixos — despesas gerais (fora de Funcionários/Veículos, que já têm valor próprio)
// ---------------------------------------------------------------------------

enum TagCustoFixo {
  GERAL
  SO_SERVICOS
}

model CustoFixo {
  id        String       @id @default(cuid())
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String
  nome      String
  valor     Decimal      @db.Decimal(12, 2)
  tag       TagCustoFixo @default(GERAL)
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Produtos/Serviços, Vendas, Metas, Fluxo de Caixa
// ---------------------------------------------------------------------------

enum Frente {
  VENDA_USINAS
  SERVICOS
  MRR
}

model ProdutoServico {
  id            String   @id @default(cuid())
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  nome          String
  frente        Frente
  custoVariavel Decimal  @default(0) @db.Decimal(12, 2)
  ativo         Boolean  @default(true)

  vendas    Venda[]
  maoDeObra ServicoMaoDeObra[]
  insumos   ServicoInsumo[]

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Construtor de custo de um Serviço (Precificação > Serviços): mão de obra
// puxada dos Cadastros (Funcionário/Veículo por hora, Terceirizado por
// diária ou placa) ou avulsa, mais insumos — soma vira ProdutoServico.custoVariavel,
// que alimenta a calculadora de percentuais já existente (sem duplicá-la).
// ---------------------------------------------------------------------------

enum OrigemMaoDeObra {
  FUNCIONARIO
  VEICULO
  TERCEIRIZADO
  AVULSO
}

model ServicoMaoDeObra {
  id               String          @id @default(cuid())
  produtoServico   ProdutoServico  @relation(fields: [produtoServicoId], references: [id], onDelete: Cascade)
  produtoServicoId String
  origem           OrigemMaoDeObra
  funcionario      Funcionario?    @relation(fields: [funcionarioId], references: [id])
  funcionarioId    String?
  veiculo          Veiculo?        @relation(fields: [veiculoId], references: [id])
  veiculoId        String?
  terceirizado     Terceirizado?   @relation(fields: [terceirizadoId], references: [id])
  terceirizadoId   String?
  descricao        String? // usado só quando origem = AVULSO
  valorUnitario    Decimal?        @db.Decimal(12, 2) // usado só quando origem = AVULSO
  quantidade       Decimal         @default(1) @db.Decimal(10, 2) // horas (Funcionário/Veículo), diárias ou placas (Terceirizado), ou unidades (Avulso)
  criadoEm         DateTime        @default(now())

  @@index([produtoServicoId])
}

model ServicoInsumo {
  id               String         @id @default(cuid())
  produtoServico   ProdutoServico @relation(fields: [produtoServicoId], references: [id], onDelete: Cascade)
  produtoServicoId String
  descricao        String
  valor            Decimal        @db.Decimal(12, 2)
  criadoEm         DateTime       @default(now())

  @@index([produtoServicoId])
}

model Venda {
  id              String          @id @default(cuid())
  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId       String
  data            DateTime
  frente          Frente
  produtoServico  ProdutoServico? @relation(fields: [produtoServicoId], references: [id])
  produtoServicoId String?
  tipoServico     String?
  precoCobrado    Decimal         @db.Decimal(12, 2)
  custoVariavel   Decimal         @default(0) @db.Decimal(12, 2)
  mesFechado      Boolean         @default(false)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  edicoes VendaEdicaoLog[]

  @@index([empresaId])
  @@index([empresaId, data])
}

// Log de auditoria — toda edição de uma venda, enquanto o mês está aberto, pede um motivo
model VendaEdicaoLog {
  id         String   @id @default(cuid())
  venda      Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  vendaId    String
  motivo     String
  camposAntes Json
  camposDepois Json
  editadoEm  DateTime @default(now())
}

model MetaFrente {
  id            String   @id @default(cuid())
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId     String
  frente        Frente
  mesReferencia String   // formato "YYYY-MM"
  metaValor     Decimal  @db.Decimal(12, 2)
  ticketMedio   Decimal  @db.Decimal(12, 2)
  percConversao Decimal  @db.Decimal(6, 2)

  @@unique([empresaId, frente, mesReferencia])
}

model LancamentoCaixa {
  id                String   @id @default(cuid())
  empresa           Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId         String
  mesReferencia     String   // "YYYY-MM"
  receitaPrevista   Decimal  @default(0) @db.Decimal(12, 2)
  receitaRealizada  Decimal  @default(0) @db.Decimal(12, 2)
  custoVariavel     Decimal  @default(0) @db.Decimal(12, 2)
  custoFixo         Decimal  @default(0) @db.Decimal(12, 2)
  impostos          Decimal  @default(0) @db.Decimal(12, 2)

  @@unique([empresaId, mesReferencia])
}

model PlanoNegocio {
  id        String   @id @default(cuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId String   @unique
  conteudo  Json?
  atualizadoEm DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Auditoria de "Representar" (impersonação): alguém da equipe Duo Fraguima
// acessando o painel do lado do cliente para dar suporte. A sessão de suporte
// em si não usa nenhuma tabela — ela é só um JWT com userType "cliente" mais
// os metadados de quem está representando (ver src/auth.ts) — este modelo é
// só o registro permanente de quando isso aconteceu, para fins de auditoria.
// encerradoEm é "best-effort": fechado quando a pessoa clica em "Encerrar
// atendimento" OU na primeira requisição depois da expiração automática
// (30 min); se a sessão simplesmente for abandonada sem nenhuma requisição
// nova, o registro pode ficar em aberto além desse prazo — iniciadoEm + 30min
// é o limite superior real de quanto tempo o modo suporte ficou ativo.
model ImpersonacaoLog {
  id               String    @id @default(cuid())
  usuarioInterno   UsuarioInterno @relation(fields: [usuarioInternoId], references: [id])
  usuarioInternoId String
  empresa          Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  empresaId        String
  iniciadoEm       DateTime  @default(now())
  encerradoEm      DateTime?

  @@index([empresaId])
  @@index([usuarioInternoId])
}
